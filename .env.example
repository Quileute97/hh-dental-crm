# ============================================================================
# HH DENTAL CLINIC - SUPABASE CONFIGURATION
# ============================================================================

# Supabase Project URL (Singapore Region - ap-southeast-1)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Client-side safe, dùng cho trình duyệt & Cloudflare Pages)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (CHỈ DÙNG LOCAL CHO MIGRATION SCRIPT scripts/migrate.mjs)
# TUYỆT ĐỐI KHÔNG commit key này lên git hoặc cấu hình vào Cloudflare Pages!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
